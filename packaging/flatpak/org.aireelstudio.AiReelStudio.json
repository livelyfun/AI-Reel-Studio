{
  "app-id": "org.aireelstudio.AiReelStudio",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "ai-reel",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=network",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-download",
    "--talk-name=org.freedesktop.secrets"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc"
  ],
  "modules": [
    {
      "name": "x264",
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig"
      ],
      "config-opts": [
        "--enable-shared",
        "--enable-pic",
        "--disable-cli"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://code.videolan.org/videolan/x264.git",
          "commit": "baee400fa9ced6f5481a728138fed6e8673e8f97"
        }
      ]
    },
    {
      "name": "lame",
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share"
      ],
      "config-opts": [
        "--enable-shared",
        "--disable-static"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz",
          "sha256": "ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e"
        }
      ]
    },
    {
      "name": "ffmpeg",
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man"
      ],
      "config-opts": [
        "--enable-shared",
        "--disable-static",
        "--enable-gpl",
        "--enable-libx264",
        "--enable-libmp3lame"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ffmpeg.org/releases/ffmpeg-6.1.1.tar.xz",
          "sha256": "8684f4b00f94b1633de08d4f40f09b5311f4350ea265697669d05e2634d2847a"
        }
      ]
    },
    {
      "name": "ai-reel",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../../"
        }
      ]
    }
  ]
}
